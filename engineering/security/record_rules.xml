<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Engineering users may only WRITE engineering.project when
             state is 'draft' (FR-014 lock-on-send). Reads are allowed
             in all states so users can review prior revisions. -->
        <record id="rule_engineering_project_draft_edit" model="ir.rule">
            <field name="name">Engineering Project: draft-only write for engineering</field>
            <field name="model_id" ref="model_engineering_project"/>
            <field name="domain_force">
                ['|', ('state', '=', False), ('state', '=', 'draft')]
            </field>
            <field name="groups" eval="[(4, ref('group_engineering_user'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="global" eval="False"/>
        </record>

        <!-- Commercial users may read engineering.project in any state. -->
        <record id="rule_engineering_project_commercial_read" model="ir.rule">
            <field name="name">Engineering Project: commercial read all states</field>
            <field name="model_id" ref="model_engineering_project"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_commercial_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="global" eval="False"/>
        </record>

        <!-- BoM: engineering write only when project state == draft. -->
        <record id="rule_engineering_bom_draft_edit" model="ir.rule">
            <field name="name">Engineering BoM: draft-only write for engineering</field>
            <field name="model_id" ref="model_engineering_bom"/>
            <field name="domain_force">
                ['|', ('state', '=', False), ('state', '=', 'draft')]
            </field>
            <field name="groups" eval="[(4, ref('group_engineering_user'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="global" eval="False"/>
        </record>

        <!-- BoQ: engineering write only when project state == draft. -->
        <record id="rule_engineering_boq_draft_edit" model="ir.rule">
            <field name="name">Engineering BoQ: draft-only write for engineering</field>
            <field name="model_id" ref="model_engineering_boq"/>
            <field name="domain_force">
                ['|', ('state', '=', False), ('state', '=', 'draft')]
            </field>
            <field name="groups" eval="[(4, ref('group_engineering_user'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="global" eval="False"/>
        </record>

    </data>
</odoo>