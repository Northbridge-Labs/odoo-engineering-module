<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Engineering BoQ: list -->
        <record id="view_engineering_boq_list" model="ir.ui.view">
            <field name="name">engineering.boq.list</field>
            <field name="model">engineering.boq</field>
            <field name="arch" type="xml">
                <list string="Engineering BoQs">
                    <field name="name"/>
                    <field name="project_id"/>
                    <field name="total_standard_cost"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <!-- Engineering BoQ: form with editable line_ids tree -->
        <record id="view_engineering_boq_form" model="ir.ui.view">
            <field name="name">engineering.boq.form</field>
            <field name="model">engineering.boq</field>
            <field name="arch" type="xml">
                <form string="Engineering Bill of Quantities">
                    <sheet>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <group>
                            <field name="project_id"
                                   readonly="state != 'draft'"/>
                            <field name="total_standard_cost" readonly="1"/>
                            <field name="state" readonly="1"/>
                        </group>
                        <notebook>
                            <page string="Service Lines" name="lines_page">
                                <field name="line_ids"
                                       readonly="state != 'draft'">
                                    <list editable="bottom">
                                        <field name="product_id"/>
                                        <field name="product_qty"/>
                                        <field name="product_uom_id"
                                               groups="uom.group_uom"/>
                                        <field name="standard_cost" readonly="1"/>
                                        <field name="line_cost" readonly="1"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_engineering_boq" model="ir.actions.act_window">
            <field name="name">Engineering Bill of Quantities</field>
            <field name="res_model">engineering.boq</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_engineering_boq_action"
                  name="Bill of Quantities"
                  parent="menu_engineering_boq"
                  action="action_engineering_boq"
                  sequence="10"/>

    </data>
</odoo>