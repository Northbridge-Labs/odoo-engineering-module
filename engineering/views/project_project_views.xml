<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Extend project.project form with an Engineering smart button
             back-linking to the engineering project. -->
        <record id="view_project_project_engineering_form" model="ir.ui.view">
            <field name="name">project.project.form.engineering</field>
            <field name="model">project.project</field>
            <field name="inherit_id" ref="project.edit_project"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@class='oe_button_box']" position="inside">
                    <button name="action_open_engineering_project"
                            type="object" class="oe_stat_button"
                            icon="fa-wrench"
                            invisible="not engineering_project_id">
                        <div class="o_stat_info">
                            <span class="o_stat_text">Engineering</span>
                        </div>
                    </button>
                    <field name="engineering_project_id" invisible="1"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>